# =================================================================
# ВАЖНО: В GitHub Codespaces эти переменные загружаются из Secrets
# Перейдите в Settings -> Secrets and variables -> Codespaces
# И добавьте следующие секреты:
# =================================================================

# Yandex Cloud Configuration
# Получите на https://console.yandex.cloud/folders
YANDEX_FOLDER_ID=your_folder_id_here

# API ключ Yandex Cloud (в GitHub Secrets: YANDEX_CLOUD_API_KEY)
# Создайте на https://console.yandex.cloud/iam/api-keys
YANDEX_CLOUD_API_KEY=your_api_key_here

# ID ассистента Yandex AI
# Создайте на https://console.yandex.cloud/ai-agents
YANDEX_AGENT_ID=your_agent_id_here

# OpenAI Configuration (для переключения AI провайдера)
# Получите на https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# 2-шаговый пайплайн: разные модели для разных задач
# Генерация тем: быстро, дешево, разнообразно
OPENAI_THEMES_MODEL=gpt-4o-mini

# Генерация постов: качество текста, креатив, связность
OPENAI_POST_MODEL=gpt-5.2

# Vector Store ID (опционально, для file_search)
# Создайте через: python scripts/openai_ingestion.py
# OPENAI_VECTOR_STORE_ID=vs-your_vector_store_id_here

# Telegram Bot Configuration
# Получите токен у @BotFather в Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Username нужен для безопасной ссылки из группового чата в личный
TELEGRAM_BOT_USERNAME=natrium_smm_bot

# Тренеры, которым доступны коды клиентов и кабинет. Если список пуст,
# используется существующий ADMIN_TELEGRAM_ID.
ADMIN_TELEGRAM_ID=your_admin_telegram_id_here
# TRAINER_TELEGRAM_IDS=123456789,987654321

# Дневник питания
NUTRITION_DB_PATH=data/nutrition/nutrition.sqlite3
NUTRITION_VISION_MODEL=gpt-4o-mini
NUTRITION_AI_TIMEOUT_SECONDS=30

# Веб-панель выключена, пока не настроен подтвержденный HTTPS origin.
NUTRITION_DASHBOARD_ENABLED=0
NUTRITION_DASHBOARD_HOST=127.0.0.1
NUTRITION_DASHBOARD_PORT=8080
# NUTRITION_DASHBOARD_ORIGIN=https://nutrition.example.org
# NUTRITION_DASHBOARD_AUTH_TTL_SECONDS=600
NUTRITION_DASHBOARD_SESSION_TTL_SECONDS=43200

# Напоминания запускаются только при явном включении; личные настройки по умолчанию выключены.
NUTRITION_REMINDERS_ENABLED=0

# Умная справка: модель и предельное время одного запроса.
NUTRITION_HELP_MODEL=gpt-4o-mini
NUTRITION_HELP_TIMEOUT_SECONDS=12

# Optional: Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
