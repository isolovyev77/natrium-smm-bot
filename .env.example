# =================================================================
# ВАЖНО: В GitHub Codespaces эти переменные загружаются из Secrets
# Перейдите в Settings -> Secrets and variables -> Codespaces
# И добавьте следующие секреты:
# =================================================================

# Yandex Cloud Configuration
# Получите на https://console.yandex.cloud/folders
YANDEX_FOLDER_ID=your_folder_id_here

# API ключ Yandex Cloud (в GitHub Secrets: YANDEX_CLOUD_API_KEY)
# Создайте на https://console.yandex.cloud/iam/api-keys
YANDEX_CLOUD_API_KEY=your_api_key_here

# ID ассистента Yandex AI
# Создайте на https://console.yandex.cloud/ai-agents
YANDEX_AGENT_ID=your_agent_id_here

# OpenAI Configuration (для переключения AI провайдера)
# Получите на https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Модель OpenAI (gpt-4o, gpt-4o-mini, gpt-4-turbo, gpt-5.2)
OPENAI_MODEL=gpt-4o-mini

# Telegram Bot Configuration
# Получите токен у @BotFather в Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Optional: Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
